{
  "mcpServers": {
    "jira": {
      "command": "python",
      "args": ["${LOCAL_MCP_DIR}/mcp_jira_server.py"],
      "disabled": false,
      "autoApprove": [
        "create_jira_ticket",
        "get_jira_ticket",
        "list_projects",
        "search_jira",
        "add_jira_comment"
      ],
      "env": {
        "LOCAL_MCP_DIR": "${LOCAL_MCP_DIR}",
        "JIRA_USERNAME": "${JIRA_USERNAME}",
        "JIRA_TOKEN": "${JIRA_TOKEN}",
        "JIRA_DEFAULT_PROJECT": "${JIRA_DEFAULT_PROJECT}"
      }
    },
    "sumologic": {
      "command": "python",
      "args": ["${LOCAL_MCP_DIR}/mcp_sumo_server.py"],
      "disabled": false,
      "autoApprove": ["sumologic_search_logs"],
      "env": {
        "LOCAL_MCP_DIR": "${LOCAL_MCP_DIR}",
        "SUMO_ACCESS_ID": "${SUMO_ACCESS_ID}",
        "SUMO_ACCESS_KEY": "${SUMO_ACCESS_KEY}",
        "SUMO_DEFAULT_INDEX": "${SUMO_DEFAULT_INDEX}"
      }
    }
  }
}
